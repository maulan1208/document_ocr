# Compose uses these values to configure PostgreSQL and build DATABASE_URL.
POSTGRES_DB=document_ocr
POSTGRES_USER=document_ocr
POSTGRES_PASSWORD=replace-with-output-from-openssl-rand-hex-24

# Required by the application at startup.
OPENAI_API_KEY=replace-with-your-openai-api-key
CHAT_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
